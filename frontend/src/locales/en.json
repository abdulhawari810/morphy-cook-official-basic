  "legal": {
    "privacy": {
      "title": "Privacy Policy",
      "updated": "Last updated: October 2026",
      "section1_title": "1. Data we collect",
      "section1_body": "We store account data (username, email, encrypted password), profiles, recipes, favourites, and reviews you create. In demo mode, data is stored in your browser's IndexedDB.",
      "section2_title": "2. How we use data",
      "section2_body": "Data is used to run the app: login, showing recipes, favourites, and reviews. We do not sell your data to third parties.",
      "section3_title": "3. Cookies and tokens",
      "section3_body": "Login uses JWT tokens stored in httpOnly cookies (server mode) or localStorage (demo mode). Tokens identify your login session.",
      "section4_title": "4. Data sharing",
      "section4_body": "We do not share your personal data except when required by law or to operate the service (e.g. hosting).",
      "section5_title": "5. Security",
      "section5_body": "Passwords are stored encrypted and API access is token-protected. No system is 100% secure; use a strong, unique password.",
      "section6_title": "6. Your rights",
